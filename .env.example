PROJECT_NAME=ComplAIs API
API_V1_STR=/api/v1
DEBUG=false

# ---------------------------------------------------------------------------
# DATABASE_URL
# 셸에서 임시 지정:
#   export DATABASE_URL="postgresql://user:password@localhost:5432/complais"
#   export DATABASE_URL="mysql+pymysql://user:password@localhost:3306/complais"
# ---------------------------------------------------------------------------

# PostgreSQL 사용 시 (예시)
# DATABASE_URL=postgresql://user:password@localhost:5432/complais

# MySQL/MariaDB 사용 시 (예시, SQLAlchemy는 mysql+pymysql 권장)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/complais

# XAMPP 기본(비밀번호 없음). root에 비밀번호가 있으면 user:password 형식으로 변경.
DATABASE_URL=mysql+pymysql://root@localhost:3306/complais?charset=utf8mb4

# JWT signing key — change this in production.
SECRET_KEY=YOUR_SUPER_SECRET_KEY_CHANGE_THIS
