PROJECT_NAME="ComplAIs API"
API_V1_STR=/api/v1
DEBUG=false

# ---------------------------------------------------------------------------
# DATABASE_URL
# 셸에서 임시 지정:
#   export DATABASE_URL="postgresql://user:password@localhost:5432/complais"
#   export DATABASE_URL="mysql+pymysql://user:password@localhost:3306/complais"
#
# Render PostgreSQL (DBeaver / 로컬 Alembic = External URL + SSL):
#   export DATABASE_URL="postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require"
#   ./scripts/dbeaver-connection.sh   # 호스트/포트만 안전하게 출력
#   ./scripts/db-check.sh
#   ./scripts/db-migrate.sh           # alembic upgrade head
#
# Render Web Service 내부에서는 Blueprint가 Internal connectionString 을 주입합니다.
# ---------------------------------------------------------------------------

# PostgreSQL 사용 시 (예시)
# DATABASE_URL=postgresql://user:password@localhost:5432/complais

# MySQL/MariaDB 사용 시 (예시, SQLAlchemy는 mysql+pymysql 권장)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/complais

# XAMPP 기본(비밀번호 없음). root에 비밀번호가 있으면 user:password 형식으로 변경.
DATABASE_URL=mysql+pymysql://root@localhost:3306/complais?charset=utf8mb4

# JWT signing key — change this in production.
# Render Dashboard: set SECRET_KEY (app reads this). JWT_SECRET is optional alias only.
SECRET_KEY=YOUR_SUPER_SECRET_KEY_CHANGE_THIS

# ---------------------------------------------------------------------------
# PortOne 본인인증 (테스트/샌드박스) — 실제 시크릿을 저장소에 커밋하지 마세요.
# V1: PORTONE_IMP_CODE (가맹점 식별코드, IMP.init)
# V2: PORTONE_STORE_ID + PORTONE_CHANNEL_KEY_KAKAO / PORTONE_CHANNEL_KEY_NAVER
# 서버 검증(선택): PORTONE_API_SECRET
# 키 미설정 시 프론트는 [테스트 본인인증] mock 버튼을 사용합니다.
# ---------------------------------------------------------------------------
# PORTONE_IMP_CODE=imp00000000
# PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_CHANNEL_KEY_KAKAO=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_CHANNEL_KEY_NAVER=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_API_SECRET=
PORTONE_ALLOW_MOCK=true

# Optional: AI 심사노트 문장 정형화
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
